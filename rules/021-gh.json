{
  "name": "021-gh",
  "enabled": true,
  "action": "allow",
  "duration": "always",
  "precedence": true,
  "operator": {
    "type": "list",
    "operand": "list",
    "list": [
      { "type": "simple", "operand": "process.path", "data": "/usr/bin/gh" },
      { "type": "lists",  "operand": "lists.domains",
        "data": "/etc/opensnitchd/lists/github-domains.txt" }
    ]
  }
}
