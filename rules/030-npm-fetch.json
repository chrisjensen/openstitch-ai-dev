{
  "name": "030-npm-fetch",
  "enabled": true,
  "action": "allow",
  "duration": "always",
  "precedence": true,
  "operator": {
    "type": "list",
    "operand": "list",
    "list": [
      { "type": "regexp", "operand": "process.path",
        "data": "^/home/chris/\\.nvm/versions/node/v[0-9.]+/bin/node$" },
      { "type": "regexp", "operand": "process.command",
        "data": "(npm-cli\\.js|/pnpm/bin/pnpm\\.cjs|/yarn/bin/yarn\\.js|npx-cli\\.js)" },
      { "type": "lists",  "operand": "lists.domains",
        "data": "/etc/opensnitchd/lists/npm-domains.txt" }
    ]
  }
}
