{
  "name": "080b-claude-webfetch",
  "enabled": true,
  "action": "allow",
  "duration": "always",
  "operator": {
    "type": "list",
    "operand": "list",
    "list": [
      { "type": "regexp", "operand": "process.path",
        "data": "^/home/chris/\\.nvm/versions/node/v[0-9.]+/bin/node$" },
      { "type": "regexp", "operand": "process.command",
        "data": "/home/chris/\\.local/share/claude/versions/" },
      { "type": "lists",  "operand": "lists.domains",
        "data": "/etc/opensnitchd/lists/claude-webfetch-domains.txt" }
    ]
  }
}
