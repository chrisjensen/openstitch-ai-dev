{
  "Server": {
    "Address": "unix:///tmp/osui.sock",
    "LogFile": "/var/log/opensnitchd.log",
    "Authentication": { "Type": "simple" }
  },
  "DefaultAction": "deny",
  "DefaultDuration": "always",
  "InterceptUnknown": false,
  "ProcMonitorMethod": "proc",
  "LogLevel": 2,
  "Firewall": "nftables",
  "Stats": { "MaxEvents": 150, "MaxStats": 25 }
}
